(version 1)

# Issue 8: the board-setup minimum (0.15 mm) is an absolute floor that custom
# rules cannot relax, so it stays at what the DRV8231A's 0.5 mm pin field needs,
# and this rule raises every other track to 0.2 mm.  It must stay FIRST: when two
# rules set the same constraint, KiCad uses the later one, and every stricter
# rule below (motor, USB, power, battery) has to be able to override it.
(rule "Signal minimum width"
	(constraint track_width (min 0.2mm))
	(condition "A.Type == 'Track' && !A.enclosedByArea('Motor pin escape')"))

# Motor outputs retain their original high-current trunk geometry; the current
# revision regulates at 0.828 A nominal, below the 1 A contact rating, so the
# trunks are 0.8 mm.  Only the escapes inside each driver's 0.5 mm pin field may
# neck below that, and those are fenced by the "Motor pin escape" rule areas —
# without this rule the global 0.15 mm minimum lets a long 0.15 mm run pass DRC,
# which is how the 2026-09-21 review found 38 mm of MOT_B_1 at 0.15 mm.
(rule "Motor trunk minimum width"
	(constraint track_width (min 0.6mm))
	(condition "A.NetClass == 'Motor' && !A.enclosedByArea('Motor pin escape')"))

# Issue 6: copper clearance ignores same-net solder-wicking paths. Check the
# entire hole against SMD pads. via_openings.py additionally checks actual mask
# and paste apertures (including paste-only pads) and verifies fill/cap settings.
(rule "Via drill to solder pad"
	(constraint physical_hole_clearance (min 0.1mm))
	(condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))

# Only these four thermal vias may overlap their own exposed-pad apertures.
# Their per-via filling/capping properties and fabrication note require type VII.
(rule "Filled capped driver thermal vias"
	(constraint physical_hole_clearance (min -1mm))
	(condition "A.Type == 'Via' && A.NetName == 'GND' && A.Hole == 0.25mm && A.Diameter == 0.45mm && (A.Position_Y == 113.6mm || A.Position_Y == 114.4mm) && B.Type == 'Pad' && (B.Pad_Number == '9' || B.Pad_Number == '') && ((A.Position_X == 109mm && B.Reference == 'U4') || (A.Position_X == 117mm && B.Reference == 'U5'))"))

# Issue 8: supply paths.  Power (D2 -> VSYS -> the buck input) and Battery
# (BT1 -> F1 -> Q1, up to ~3.4 A with both motors at their current limit, issue
# 17).  The netclasses route them at 0.6 / 1.0 mm; these are the floors.  The
# USB input (F2 -> VBUS -> D1) left with the move to a plug-in DevKitC-1, and
# with it U2's 'Power pin escape' exception.  /VBAT is not in either class: its
# current runs in the In2 island, and its tracks are pad stubs to plane vias
# whose width the pin pitch sets, not the current.
(rule "Power path width"
	(constraint track_width (min 0.5mm))
	(condition "A.NetClass == 'Power'"))

(rule "Battery path width"
	(constraint track_width (min 0.8mm))
	(condition "A.NetClass == 'Battery'"))

# Issue 8: the "keep away" layout constraints in CLAUDE.md, as floors.  Each is
# set just under what the board achieves (measured exactly, see
# layout/issue8-rules/, layout/reg-en/ and layout/ipropi/), so these guard
# against erosion; they do not certify the constraint.
#   REG_EN  (~20 kOhm, 1.2 V above a comparator threshold): 0.95 mm, U3's own
#           EN pin to its SW pin across the TSOT-23-6.  No copper can be closer
#           than the package puts them.  Everything the layout adds stays
#           outside U3: R8/C13 sit beside U3.2 and the EN copper leaves west
#           (2026-09-24).  Before that, an EN via under the package sat
#           0.40 mm from the SW pin, and this floor was 0.35 mm.
#   IPROPI  (GPIO2/GPIO10, 1 kOhm): 0.80 mm, GPIO10's pin-escape via beside
#           U4's MOT_A_2 loop; GPIO2's nearest is U4's own pin 1 to pin 8,
#           1.30 mm.  Every other stretch of both runs is 1.0 mm or more from
#           motor copper.  R17/R18 moved and the near-driver runs were re-laid
#           (2026-09-24); before that, 0.53 mm and this floor was 0.25 mm.
# REG_EN and VBAT_SENSE (150 kOhm) are 7.75 mm and >20 mm from motor copper.
(rule "REG_EN clear of the switch node"
	(constraint clearance (min 0.9mm))
	(condition "A.NetName == '/REG_EN' && (B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

(rule "Sense nodes clear of motor and switch copper"
	(constraint clearance (min 5mm))
	(condition "(A.NetName == '/REG_EN' && B.NetClass == 'Motor') || (A.NetName == '/VBAT_SENSE' && (B.NetClass == 'Motor' || B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)'))"))

(rule "IPROPI clear of motor outputs"
	(constraint clearance (min 0.75mm))
	(condition "(A.NetName == '/GPIO2' || A.NetName == '/GPIO10') && B.NetClass == 'Motor'"))

# Independent motor cutoff: keep its high-impedance comparator node away
# from the same switching copper as VBAT_SENSE. Negative-tested in the audit.
(rule "Motor UVLO clear of switching copper"
	(constraint clearance (min 5mm))
	(condition "A.NetName == '/MOTOR_UVLO' && (B.NetClass == 'Motor' || B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

# The IMU's SPI bus (GPIO11-17) was given its own corridor, J10 behind the IMU,
# so it never runs beside motor or switch-node copper; the closest it comes is
# 10.0 mm (GPIO14 to MOT_B_2).  The 2026-10-14 power stage re-routed it along
# motor B's trunk at 0.75 mm without DRC noticing.  Negative-tested 2026-10-15.
(rule "SPI clear of motor and switch copper"
	(constraint clearance (min 5mm))
	(condition "(A.NetName == '/GPIO11' || A.NetName == '/GPIO12' || A.NetName == '/GPIO13' || A.NetName == '/GPIO14' || A.NetName == '/GPIO15' || A.NetName == '/GPIO16' || A.NetName == '/GPIO17') && (B.NetClass == 'Motor' || B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

# Encoder outputs are 10 k open-drain lines into the pulse counters: keep them
# off the buck's 1.1 MHz switch node (closest: GPIO21, 9.7 mm; it was moved to
# 1.6 mm once).  They share J8/J9 with the motor wires, so no motor floor.
(rule "Encoders clear of the switch node"
	(constraint clearance (min 5mm))
	(condition "(A.NetName == '/GPIO18' || A.NetName == '/GPIO21' || A.NetName == '/GPIO47' || A.NetName == '/GPIO48') && (B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

# I2C (2.2 k pull-ups) passes the buck on its way between J6 and J5.  SCL ran
# under C12 and past C6's BST pad at 0.45 mm until C12's GND via moved east of
# its pad (2026-10-16); the closest is now SCL to BST, 4.4 mm.  Negative-tested.
(rule "I2C clear of the switch node"
	(constraint clearance (min 3mm))
	(condition "(A.NetName == '/GPIO8' || A.NetName == '/GPIO9') && (B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

# The board-setup hole clearance stays at JLCPCB's 0.20 mm NPTH-to-copper floor
# (it was lowered for J1's own locating holes, and board-setup minimums cannot be
# raised back per pair).  J1 left with the move to a plug-in DevKitC-1, so this
# rule now restores the project's 0.30 mm everywhere.
(rule "Hole clearance"
	(constraint hole_clearance (min 0.3mm)))
