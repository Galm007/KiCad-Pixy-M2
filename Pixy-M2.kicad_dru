(version 1)

# Issue 8: the board-setup minimum (0.15 mm) is an absolute floor that custom
# rules cannot relax, so it stays at what the DRV8231A's 0.5 mm pin field needs,
# and this rule raises every other track to 0.2 mm.  It must stay FIRST: when two
# rules set the same constraint, KiCad uses the later one, and every stricter
# rule below (motor, USB, power, battery) has to be able to override it.
(rule "Signal minimum width"
	(constraint track_width (min 0.2mm))
	(condition "A.Type == 'Track' && !A.enclosedByArea('Motor pin escape')"))

# Motor outputs carry the DRV8231A's 1.47 A regulated limit (issue 15/17), so the
# trunks are 0.8 mm.  Only the escapes inside each driver's 0.5 mm pin field may
# neck below that, and those are fenced by the "Motor pin escape" rule areas —
# without this rule the global 0.15 mm minimum lets a long 0.15 mm run pass DRC,
# which is how the 2026-09-21 review found 38 mm of MOT_B_1 at 0.15 mm.
(rule "Motor trunk minimum width"
	(constraint track_width (min 0.6mm))
	(condition "A.NetClass == 'Motor' && !A.enclosedByArea('Motor pin escape')"))

# Issue 6: copper clearance ignores same-net solder-wicking paths. Check the
# entire hole against SMD pads. via_openings.py additionally checks actual mask
# and paste apertures (including paste-only pads) and verifies fill/cap settings.
(rule "Via drill to solder pad"
	(constraint physical_hole_clearance (min 0.1mm))
	(condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))

# Only these four thermal vias may overlap their own exposed-pad apertures.
# Their per-via filling/capping properties and fabrication note require type VII.
(rule "Filled capped driver thermal vias"
	(constraint physical_hole_clearance (min -1mm))
	(condition "A.Type == 'Via' && A.NetName == 'GND' && A.Hole == 0.25mm && A.Diameter == 0.45mm && (A.Position_Y == 113.6mm || A.Position_Y == 114.4mm) && B.Type == 'Pad' && (B.Pad_Number == '9' || B.Pad_Number == '') && ((A.Position_X == 109mm && B.Reference == 'U4') || (A.Position_X == 117mm && B.Reference == 'U5'))"))

# Issue 7: USB D+/D- are a 90 ohm pair, 0.25 mm / 0.15 mm on F.Cu over the In1
# ground plane (field-solved against this stackup; confirm with the fab's
# calculator before ordering).  The USB netclass carries the geometry; these
# rules make DRC fail if a later edit narrows a line, spreads the pair, or
# moves either line off the ground-referenced top layer.  The pair has to split
# to reach U2's 1.9 mm and U1's 1.27 mm pin pitch; that is ~3.4 mm uncoupled
# as routed, so 4 mm catches a pair that separates anywhere else.
(rule "USB line width"
	(constraint track_width (min 0.24mm) (opt 0.25mm) (max 0.26mm))
	(condition "A.NetClass == 'USB'"))

(rule "USB lines stay on F.Cu"
	(layer "B.Cu")
	(constraint disallow track via)
	(condition "A.NetClass == 'USB'"))

(rule "USB pair coupling"
	(constraint diff_pair_gap (min 0.14mm) (opt 0.15mm) (max 0.16mm))
	(constraint diff_pair_uncoupled (max 4mm))
	(condition "A.inDiffPair('/USB_D*')"))

# Issue 8: supply paths.  Power (USB input -> F2 -> VBUS -> D1 -> VSYS) carries
# the whole board on USB, F2 holding 0.5 A and tripping at 1 A; Battery (BT1 ->
# F1 -> Q1) carries up to ~3.4 A with both motors at their current limit (issue
# 17).  The netclasses route them at 0.6 / 1.0 mm; these are the floors.  The
# only exception is U2's VBUS pin, which leaves under the package between the
# pin rows at 0.3 mm, fenced by the 'Power pin escape' rule area.  /VBAT is not
# in either class: its current runs in the In2 island, and its tracks are pad
# stubs to plane vias whose width the pin pitch sets, not the current.
(rule "Power path width"
	(constraint track_width (min 0.5mm))
	(condition "A.NetClass == 'Power' && !A.enclosedByArea('Power pin escape')"))

(rule "Battery path width"
	(constraint track_width (min 0.8mm))
	(condition "A.NetClass == 'Battery'"))

# Issue 8: the "keep away" layout constraints in CLAUDE.md, as floors.  Each is
# set just under what the board achieves (measured exactly, see
# layout/issue8-rules/), so these guard against erosion; they do not certify
# the constraint.  Two of them sit well below what CLAUDE.md asks for:
#   REG_EN  (~20 kOhm, 1.2 V above a comparator threshold): 0.40 mm, U3's EN
#           via under the package to the SW pin.  The standing fix is to put
#           R8/C13 next to U3.2 and re-place the EN network.
#   IPROPI  (GPIO2/GPIO10, 1.5 kOhm): 0.29 mm, a GPIO2 via beside a MOT_A_2
#           B.Cu trunk near U4.  Validate the current reading on hardware.
# REG_EN and VBAT_SENSE (150 kOhm) are 7.75 mm and >20 mm from motor copper.
(rule "REG_EN clear of the switch node"
	(constraint clearance (min 0.35mm))
	(condition "A.NetName == '/REG_EN' && (B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)')"))

(rule "Sense nodes clear of motor and switch copper"
	(constraint clearance (min 5mm))
	(condition "(A.NetName == '/REG_EN' && B.NetClass == 'Motor') || (A.NetName == '/VBAT_SENSE' && (B.NetClass == 'Motor' || B.NetName == 'Net-(U3-SW)' || B.NetName == 'Net-(U3-BST)'))"))

(rule "IPROPI clear of motor outputs"
	(constraint clearance (min 0.25mm))
	(condition "(A.NetName == '/GPIO2' || A.NetName == '/GPIO10') && B.NetClass == 'Motor'"))
