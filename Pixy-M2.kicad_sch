	(text "VL53L0X ToF modules (GY-VL53L0XV2) on cables. J4-J7 match the module header 1:1:"
		(at 304.8 20.32 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "451e2234-9144-4843-8625-25688f06d7b9")
	)
	(text "1 VCC, 2 GND, 3 SCL (GPIO9), 4 SDA (GPIO8), 5 GPIO1 = sensor interrupt, not used, 6 XSHUT."
		(at 304.8 22.86 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "d121d2c4-6484-42b9-ad11-4353a0545f60")
	)
	(text "The module pulls XSHUT up to its own 2V8 rail, so all four wake enabled at address 0x29."
		(at 304.8 25.4 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "81cd1deb-c1eb-49dd-9ab8-b1aeb1129ad0")
	)
	(text "Firmware must pull every XSHUT low first, then release one at a time and re-address it."
		(at 304.8 27.94 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "abc97774-4608-44ca-bec4-1a52f6dc1003")
	)
	(text "Drive GPIO4-7 OPEN-DRAIN: low to shut a sensor down, float to let the module pull it up."
		(at 304.8 30.48 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "28bf6306-1886-46c0-a621-bf9811e0210a")
	)
	(text "Module VIN 3.0-5.0V, regulates to 2.8V on board. Firmware must set 2V8 I/O (reg 0x89 bit 0)."
		(at 304.8 33.02 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "cc47cab2-61ab-48fc-9124-61d26b114f90")
	)
	(text "R15/R16: I2C bus pull-ups, fitted once per bus at the host - VL53L0X datasheet Fig. 3."
		(at 304.8 106.68 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "4ecb5437-07eb-4b7c-8e40-46da8a6fae3c")
	)
	(text "C15/C16: local reservoir for the four modules; ~19mA average each while ranging, 40mA VCSEL peak."
		(at 304.8 109.22 0)
		(effects
			(font
				(size 1.02 1.02)
			)
			(justify left)
		)
		(uuid "335a1f47-b4c3-4efc-bca2-4b68043d0fb9")
	)
