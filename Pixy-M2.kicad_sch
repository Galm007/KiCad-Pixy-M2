	(text "U1 is an ESP32-S3-DevKitC-1-N8R8 (v1.1) on two 1x22 2.54 mm SMD female headers."
		(at 16.51 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5be17bea-2d41-44ea-8c37-8432cfc9a9d3")
	)
	(text "Its own USB-UART and native-USB ports, BOOT/RESET buttons and CHIP_PU RC replace the"
		(at 16.51 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6922de9c-1f14-4f37-8b3b-6b6bbfa921ec")
	)
	(text "removed USB-C input, J11 and SW1/SW2. Flash and debug through the devkit's USB ports."
		(at 16.51 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ac33d367-49a2-4dd9-be58-e6497f686831")
	)
	(text "Power: the AP63203 feeds ESP_3V3 into the devkit's 3V3 pins; its 5V pin is unused."
		(at 16.51 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "68c7fa69-71d5-469e-8f30-bf089f01e7b3")
	)
	(text "With USB plugged in, the devkit's SGM2212 LDO also drives 3V3. Neither source sinks"
		(at 16.51 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "04050ceb-fe52-4227-809d-eaf44840a318")
	)
	(text "current, so the two share the rail harmlessly, but Espressif calls the inputs"
		(at 16.51 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "330be777-66e9-48d5-b941-2fa8aad1846c")
	)
	(text "mutually exclusive. USB no longer reaches VSYS or REG_EN: the motors and the UVLO"
		(at 16.51 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3718faec-56cf-4003-9cab-4f315c82b2e0")
	)
	(text "see only the pack, and the hardware UVLO now holds with USB attached."
		(at 16.51 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c1fcbab2-291e-4147-8989-14beb29cbb4a")
	)
	(text "Unusable pins: GPIO35/36/37 (octal PSRAM on N8R8), GPIO38 (v1.1 RGB LED),"
		(at 16.51 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "03c3dc00-a1ea-44dc-b611-4d75e16e2551")
	)
	(text "GPIO19/20 (devkit USB), GPIO43/44 (devkit USB-UART), GPIO0 and CHIP_PU (devkit"
		(at 16.51 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d49912a3-68cc-44ff-8179-f67431d76553")
	)
	(text "buttons), GPIO45/46 (strapping). Encoder B OUT B is on GPIO18 for that reason."
		(at 16.51 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9b2993c6-8e48-4c40-80ce-c30ed0194ba4")
	)
	(text "No spare GPIOs remain."
		(at 16.51 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5d28a30f-2e9d-4a6d-ad07-359c3857e2e8")
	)
